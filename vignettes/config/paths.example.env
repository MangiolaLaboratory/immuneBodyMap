# Example environment configuration for the manuscript reproducibility vignettes.
# Copy to a gitignored file such as vignettes/config/paths.local.env
# or export from the shell before rendering.

# Repository root (directory containing README.md and vignettes/)
IMMUNE_HEALTHY_BODY_MAP_ROOT=/path/to/immuneHealthyBodyMap

# Publication data root (default: $IMMUNE_HEALTHY_BODY_MAP_ROOT/vignettes/data)
IMMUNE_HEALTHY_BODY_MAP_DATA=/path/to/immuneHealthyBodyMap/vignettes/data

# CELLNEXUS_METADATA is optional. Default is the public cloud URL via
# cellNexus::get_metadata_url("metadata.1.0.12.parquet").
# CELLNEXUS_METADATA=/path/to/local/metadata.1.0.12.parquet
# CELLNEXUS_CACHE_DIR=/path/to/cache

# Optional output override for the six quality-controlled plasma-niche pseudobulk objects.
# Default: $IMMUNE_HEALTHY_BODY_MAP_DATA/processed/plasma_niche
# PLASMA_NICHE_OUTPUT_DIR=/path/to/plasma_niche_pseudobulk

# Large files after Zenodo unpack (or local lab mirrors).
# Pseudobulk (public): https://doi.org/10.5281/zenodo.15798373
#   md5 88c71c0fd1d6ce2fe15eccdd7b36110f
# PSEUDOBULK_H5AD=/path/to/zenodo_release/pseudobulk/pseudobulk_se.h5ad
# sccomp L3/L0 models (public): https://doi.org/10.5281/zenodo.21389126
# SCCOMP_ESTIMATES_DIR=/path/to/zenodo_release/sccomp_estimates
# NEW_CELL_TYPE_ROOT=/path/to/NEW_CELL_TYPE
# NEW_PRED_DIR=/path/to/immuneHealthyBodyMap/vignettes/data/intermediate/fig4
# AGE_CLOCK_SE_DIR=/path/to/zenodo_release/age_clock_se
# AGE_CLOCK_ARCHIVE=/path/to/HPC_posterior/Age_Clock
# EDIT_COVARIATES_PATH=/path/to/immuneHealthyBodyMap/vignettes/targets_pipeline/functions/edit_covariates.R
# TAR_PIPELINE_ROOT=/path/to/immuneHealthyBodyMap/vignettes/targets_pipeline
# DISEASE_GROUPING_CSV=/path/to/immuneHealthyBodyMap/vignettes/data/source_tables/disease_data_grouped_further.csv
# TARGETS_USE_CREW=true
# TARGETS_SLURM_ACCOUNT=saigencir003
# TARGETS_MAKE_NAMES=adjust_age

# Optional: force Fig5 panel A rebuild
# REBUILD_FIG5_PANEL_A=false
# FIG4_PRED_WORKERS=4
